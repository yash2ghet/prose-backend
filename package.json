  "type": "commonjs",
  "main": "dist/index.mjs",
  "scripts": {
    "dev": "nodemon",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.mjs --sourcemap",
    "start": "node dist/index.mjs",
    "clean": "rm -rf dist",
    "vercel-build": "npm run typecheck",
    "deploy": "vercel deploy --prod",
    "deploy:preview": "vercel deploy",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
